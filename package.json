{
  "name": "slz-form-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Monorepo du moteur de formulaires slz-form et de ses adapters framework",
  "author": "elhabibmhadjou-slz (https://github.com/elhabibmhadjou-slz)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keleslz/slz-form-event.git"
  },
  "workspaces": [
    "packages/form",
    "packages/react-form",
    "examples/react"
  ],
  "scripts": {
    "dev": "npm run dev:react",
    "dev:react": "npm run dev -w examples/react",
    "build": "npm run build:packages && npm run build:examples",
    "build:packages": "npm run build -w packages/form && npm run build -w packages/react-form",
    "build:examples": "npm run build -w examples/react",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint packages examples",
    "release": "npm run build:packages && changeset publish",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/master",
    "version:packages": "changeset version && npm install --package-lock-only",
    "test:e2e": "npm run test:e2e -w examples/react"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.11"
  }
}
